{
  "buildCommand": "node scripts/migrar.js",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?a=recurso" },
    { "source": "/.well-known/oauth-protected-resource/:ruta*", "destination": "/api/oauth?a=recurso" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?a=metadata" },
    { "source": "/.well-known/oauth-authorization-server/:ruta*", "destination": "/api/oauth?a=metadata" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/oauth?a=metadata" },
    { "source": "/oauth/register", "destination": "/api/oauth?a=register" },
    { "source": "/oauth/token", "destination": "/api/oauth?a=token" },
    { "source": "/oauth/authorize", "destination": "/oauth/authorize.html" }
  ]
}
